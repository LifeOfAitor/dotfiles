# Your name and email go in ~/.gitconfig.local (install.sh asks for them), not here:
#   git config --file ~/.gitconfig.local user.name  "Your Name"
#   git config --file ~/.gitconfig.local user.email "you@example.com"

[init]
	defaultBranch = main
[pull]
	rebase = true
[rebase]
	autoStash = true
[push]
	autoSetupRemote = true

# GitHub credentials through the gh CLI (stored in the system keychain).
# Once per machine: gh auth login
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential

# Machine-specific settings (not in the repo)
[include]
	path = ~/.gitconfig.local
